# -----------------------------------------------------------------------------
# Multi-Agent Travel Planner (BeeAI) — environment template
# Copy to .env and fill in values before running.
# -----------------------------------------------------------------------------

# LLM model string passed to ChatModel.from_name (provider:model)
# Examples:
#   watsonx:meta-llama/llama-4-maverick-17b-128e-instruct-fp8
#   watsonx:ibm/granite-4-h-small
#   ollama:granite4:micro
#   openai:gpt-4o-mini
TRAVEL_PLANNER_LLM_MODEL=watsonx:meta-llama/llama-4-maverick-17b-128e-instruct-fp8
TRAVEL_PLANNER_LLM_TEMPERATURE=0.0

# --- IBM watsonx.ai (required when using watsonx: models) ---
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_REGION=us-south
# WATSONX_SPACE_ID=

# --- OpenAI (optional; when using openai: models) ---
# OPENAI_API_KEY=

# --- Ollama (optional; when using ollama: models) ---
# OLLAMA_BASE_URL=http://localhost:11434

# Runtime
TRAVEL_PLANNER_LOG_LEVEL=INFO
TRAVEL_PLANNER_VERBOSE=true
TRAVEL_PLANNER_MAX_QUERY_CHARS=2000
TRAVEL_PLANNER_EXPECTED_OUTPUT=Comprehensive travel plan covering destination, weather, and cultural guidance. Formatted as markdown.
TRAVEL_PLANNER_REQUIRE_HANDOFF_PERMISSION=false
TRAVEL_PLANNER_MAX_RETRIES=2
TRAVEL_PLANNER_RETRY_WAIT_SECONDS=1.5
